{
  "name": "squirrelforge/agent",
  "description": "A modular AI agent runtime framework.",
  "type": "project",
  "autoload": {
    "psr-4": {
      "SquirrelForge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SquirrelForge\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
