# The image must contain an immutable @sha256: digest, never only a tag.
SQUIRRELFORGE_ADMISSION_IMAGE=ghcr.io/example/squirrelforge@sha256:replace_with_64_hex_characters
SQUIRRELFORGE_ADMISSION_REPOSITORY=ghcr.io/example/squirrelforge
SQUIRRELFORGE_ADMISSION_SOURCE_REPOSITORY=example/squirrelforge
SQUIRRELFORGE_ADMISSION_CERTIFICATE_IDENTITY_REGEXP=^https://github.com/example/squirrelforge/.github/workflows/flock-deployment-gate.yml@refs/tags/v[0-9].*$
SQUIRRELFORGE_ADMISSION_OIDC_ISSUER=https://token.actions.githubusercontent.com
SQUIRRELFORGE_ADMISSION_BLOCK_SEVERITIES=CRITICAL,HIGH
