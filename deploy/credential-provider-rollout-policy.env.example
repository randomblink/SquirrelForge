# Names-only template for the credential-provider service's own staged
# rollout. This is an independent deployment from the main Engine API
# image (deploy/rollout-policy.env.example): its own namespace, its own
# stable/canary Deployments, its own readiness and error-rate endpoints.
# `bin/rollout-release.sh`, `bin/observe-release.sh`, and
# `bin/rollback-release.sh` are the same scripts the main image uses --
# only the values below differ per service. See
# deploy/CREDENTIAL-PROVIDER-CONTRACT.md and
# deploy/kubernetes/credential-provider-canary-deployment.yaml.
SQUIRRELFORGE_ROLLOUT_IMAGE=ghcr.io/example/squirrelforge/credential-provider@sha256:replace_with_admitted_digest
SQUIRRELFORGE_ROLLOUT_NAMESPACE=squirrelforge
SQUIRRELFORGE_ROLLOUT_STABLE_DEPLOYMENT=squirrelforge-credential-provider
SQUIRRELFORGE_ROLLOUT_CANARY_DEPLOYMENT=squirrelforge-credential-provider-canary
SQUIRRELFORGE_ROLLOUT_CONTAINER=squirrelforge-credential-provider
SQUIRRELFORGE_ROLLOUT_CANARY_REPLICAS=1
SQUIRRELFORGE_ROLLOUT_CANARY_READINESS_URL=https://squirrelforge-credential-provider-canary.example.internal/v1/provider/health
SQUIRRELFORGE_ROLLOUT_STABLE_READINESS_URL=https://squirrelforge-credential-provider.example.internal/v1/provider/health
SQUIRRELFORGE_ROLLOUT_CANARY_ERROR_RATE_URL=https://metrics.example.internal/squirrelforge-credential-provider/canary/error-rate-percent
SQUIRRELFORGE_ROLLOUT_STABLE_ERROR_RATE_URL=https://metrics.example.internal/squirrelforge-credential-provider/stable/error-rate-percent
SQUIRRELFORGE_ROLLOUT_MAXIMUM_ERROR_RATE_PERCENT=1
SQUIRRELFORGE_ROLLOUT_PROBE_COUNT=6
SQUIRRELFORGE_ROLLOUT_PROBE_INTERVAL_SECONDS=10
SQUIRRELFORGE_ROLLOUT_MAXIMUM_PROBE_FAILURES=0
SQUIRRELFORGE_ROLLOUT_TIMEOUT=180s

# The readiness/error-rate probe URLs above must themselves present the
# credential-provider's Bearer token (see the manifest's readinessProbe
# comment) -- supply that through the probe endpoint's own auth, not by
# embedding the token in these URLs.

# In the workflow's protected-rollout-credential-provider job, these same
# script-facing variable names are populated from distinctly-named GitHub
# vars/secrets (the SQUIRRELFORGE_CREDENTIAL_PROVIDER_ROLLOUT_* /
# SQUIRRELFORGE_CREDENTIAL_PROVIDER_OBSERVE_* names) so they never collide
# with the main image's own vars/secrets of the same unprefixed names.
