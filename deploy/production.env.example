SQUIRRELFORGE_ENVIRONMENT=production
SQUIRRELFORGE_ENGINE_DB=/app/var/engine.sqlite
SQUIRRELFORGE_CREDENTIAL_PROVIDER=http-json
SQUIRRELFORGE_CREDENTIAL_PROVIDER_URL=https://credential-provider.example.internal
# Inject from a secret manager at runtime. Do not commit a value.
SQUIRRELFORGE_CREDENTIAL_PROVIDER_TOKEN=
SQUIRRELFORGE_AUTH_MAX_FAILURES=5
SQUIRRELFORGE_AUTH_FAILURE_WINDOW_SECONDS=300
SQUIRRELFORGE_AUTH_LOCKOUT_SECONDS=900
SQUIRRELFORGE_PROVIDER_MAX_ATTEMPTS=3
SQUIRRELFORGE_PROVIDER_CIRCUIT_FAILURES=3
SQUIRRELFORGE_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
