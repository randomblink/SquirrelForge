SQUIRRELFORGE_CAPACITY_BASE_URL=https://squirrelforge-capacity.example.internal
SQUIRRELFORGE_CAPACITY_IDENTITY_REF=identity:capacity-test
SQUIRRELFORGE_CAPACITY_PERMISSION_REF=permission:capacity-test
# Inject from a secret manager. Do not commit a value.
SQUIRRELFORGE_CAPACITY_API_KEY=
SQUIRRELFORGE_CAPACITY_PROFILE=approved-target
SQUIRRELFORGE_CAPACITY_VUS=1
SQUIRRELFORGE_CAPACITY_DURATION=1m
SQUIRRELFORGE_CAPACITY_SUMMARY_PATH=capacity-summary.json
SQUIRRELFORGE_CAPACITY_RECEIPT_PATH=capacity-receipt.json
SQUIRRELFORGE_CAPACITY_MAXIMUM_FAILED_RATE=0.01
SQUIRRELFORGE_CAPACITY_MAXIMUM_P95_MS=1000
SQUIRRELFORGE_CAPACITY_MINIMUM_CHECK_RATE=0.99
SQUIRRELFORGE_CAPACITY_MINIMUM_ITERATIONS=1
