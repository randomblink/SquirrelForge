FROM composer:2 AS dependencies

WORKDIR /app
COPY composer.json composer.lock ./
COPY src ./src
RUN composer install --no-dev --classmap-authoritative --no-interaction --no-progress

FROM php:8.3-cli-alpine

RUN apk upgrade --no-cache \
    && apk add --no-cache sqlite-dev \
    && docker-php-ext-install pdo_sqlite

WORKDIR /app
COPY --from=dependencies /app/vendor ./vendor
COPY . .

RUN mkdir -p /app/var \
    && chown -R www-data:www-data /app/var \
    && chmod +x /app/deploy/entrypoint-credential-provider.sh /app/bin/credential-provider-preflight.php /app/bin/credential-provider-smoke-test.php

USER www-data
EXPOSE 8080

# The health endpoint requires the same Bearer auth as every other
# route (deliberately -- see CredentialProviderRouter's own doc
# comment), so the probe has to present the container's own token,
# read from the same environment the server itself is configured
# with. No token value is ever logged or embedded in the image layer.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD php -r ' \
    $token = getenv("SQUIRRELFORGE_CREDENTIAL_PROVIDER_TOKEN"); \
    $context = stream_context_create(["http" => ["header" => "Authorization: Bearer " . $token, "timeout" => 5]]); \
    $response = @file_get_contents("http://127.0.0.1:8080/v1/provider/health", false, $context); \
    exit($response !== false && (json_decode($response, true)["healthy"] ?? false) === true ? 0 : 1);'

ENTRYPOINT ["/app/deploy/entrypoint-credential-provider.sh"]
